{
  "name": "@vizij/orchestrator-wasm",
  "version": "0.3.2",
  "description": "WASM bindings for Vizij orchestrator core (JS wrapper)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vizij-ai/vizij-rs"
  },
  "type": "module",
  "main": "dist/orchestrator-wasm/src/index.js",
  "module": "dist/orchestrator-wasm/src/index.js",
  "types": "dist/orchestrator-wasm/src/index.d.ts",
  "files": [
    "dist/",
    "pkg/",
    "README.md"
  ],
  "exports": {
    ".": {
