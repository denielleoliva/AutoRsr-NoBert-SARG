      "types": "./dist/orchestrator-wasm/src/index.d.ts"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@vizij/value-json": "0.1.2",
    "@vizij/wasm-loader": "0.1.5"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.12.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../../scripts/embed-fixtures.mjs orchestrator-wasm && tsc -p tsconfig.json && node ../../../scripts/copy-wasm-pkg.mjs orchestrator-wasm",
    "test": "pnpm run build && node dist/orchestrator-wasm/tests/all.test.js"
  }
}